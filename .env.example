# --- Database (server-only) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/public-health-chatbot

# --- Auth.js (server-only) ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- OpenAI (server-only) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- File storage for uploaded documents (server-only) ---
BLOB_READ_WRITE_TOKEN=replace-if-using-vercel-blob

# --- App config (safe to expose) ---
NEXT_PUBLIC_APP_NAME="Public Health Awareness Chatbot"
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# --- Seed script only: creates/promotes the first admin account ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Optional OpenAI overrides ---
# Point at an OpenAI-compatible server (used for local testing / proxies). Leave unset for api.openai.com.
# OPENAI_BASE_URL=
# Number of previous messages sent to the model as context
CHAT_HISTORY_LIMIT=10

# --- RAG (Phase 11) ---
# atlas = MongoDB Atlas Vector Search (production). local = brute-force search in Node, for local dev only.
RETRIEVAL_MODE=atlas
# Set to false to skip retrieval and let the model answer from its own knowledge (development only!)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_CONTEXT_TOKENS=3000
